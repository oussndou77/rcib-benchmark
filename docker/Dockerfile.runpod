# Dockerfile.runpod — Image RCIB "production" pour RunPod.
#
# Résout DÉFINITIVEMENT les pièges rencontrés en Phase 0 (cf. runners/RUNPOD_GUIDE.md) :
#   - installe les 3 libs système manquantes (libjpeg, libtiff, libjbig)
#   - met l'egg carla py3.7 dans le PYTHONPATH
#   - installe pip + nos dépendances
#   - embarque le code RCIB
# Résultat : un pod démarre prêt à l'emploi, sans le bricolage manuel sans-root.
#
# Build & push (depuis ta machine avec Docker) :
#   docker build -f docker/Dockerfile.runpod -t TONUSER/rcib:0.1 .
#   docker push TONUSER/rcib:0.1
# Puis utiliser TONUSER/rcib:0.1 comme image du pod RunPod.

FROM carlasim/carla:0.9.15

# Ici on EST root (pendant le build), donc apt fonctionne — contrairement au runtime.
USER root

# Les 3 libs système que l'egg carla réclame, + pip + outils.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libjpeg-turbo8 \
        libtiff5 \
        libjbig0 \
        python3-pip \
        git \
    && rm -rf /var/lib/apt/lists/*

# Dépendances Python du projet (légères)
RUN python3 -m pip install --no-cache-dir numpy 2>/dev/null || true

# L'egg carla py3.7 fonctionne sous le Python 3.6 de l'image (validé en Phase 0).
# On l'expose via PYTHONPATH pour que `import carla` marche partout.
ENV PYTHONPATH=/home/carla/PythonAPI/carla/dist/carla-0.9.15-py3.7-linux-x86_64.egg
ENV LC_ALL=C.UTF-8
ENV LANG=C.UTF-8

# Code RCIB
WORKDIR /rcib
COPY rcib/ /rcib/rcib/
COPY runners/ /rcib/runners/
COPY tests/ /rcib/tests/

# CARLA doit tourner sous 'carla', pas root.
USER carla

# Par défaut : garder le conteneur vivant (on lance serveur + client à la main,
# ou via launch_carla.sh). Ne PAS lancer CARLA ici (RunPod gère le cycle de vie).
CMD ["bash", "-c", "sleep infinity"]
