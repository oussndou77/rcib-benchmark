# Dockerfile.runpod — Image RCIB pour RunPod (phases 2+).
#
# Étend l'image officielle CARLA 0.9.15 en ajoutant :
#   - le package Python carla (le wheel DE l'image → correspondance garantie, piège n°1)
#   - les dépendances Python du projet
#   - le code RCIB (metrics harness, scenario bridge, etc.)
#
# Pour la Phase 0 (smoke test), pas besoin de builder ceci : on lance directement
# l'image carlasim/carla:0.9.15 sur RunPod (voir RUNPOD_GUIDE.md). Ce Dockerfile
# sert dès la Phase 2, quand on embarque notre propre code.
#
# Build & push (depuis ta machine avec Docker) :
#   docker build -f docker/Dockerfile.runpod -t TONUSER/rcib:0.1 .
#   docker push TONUSER/rcib:0.1

FROM carlasim/carla:0.9.15

# CARLA tourne sous l'utilisateur 'carla' ; on passe root pour installer.
USER root

# Python + pip (l'image CARLA a Python 3.7 mais pas toujours pip à jour)
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3-pip \
        xdg-user-dirs \
    && rm -rf /var/lib/apt/lists/*

# Le wheel carla EST dans l'image → on l'installe (garantit version client==serveur).
# Le nom exact du wheel peut varier ; on prend celui présent dans dist/.
RUN python3 -m pip install --upgrade pip \
    && WHEEL=$(ls /home/carla/PythonAPI/carla/dist/carla-0.9.15-*.whl | head -n1) \
    && echo "Installation du wheel : $WHEEL" \
    && python3 -m pip install "$WHEEL"

# Dépendances du projet RCIB (légères : le harness est en lib standard + un peu de numpy)
COPY requirements.txt /tmp/requirements.txt
RUN python3 -m pip install -r /tmp/requirements.txt

# Code RCIB
WORKDIR /rcib
COPY rcib/ /rcib/rcib/
COPY runners/ /rcib/runners/
COPY tests/ /rcib/tests/

# Le serveur CARLA doit tourner sous 'carla', pas root.
USER carla

# Par défaut : lance le serveur headless. Le client se lance séparément.
CMD ["bash", "-c", "cd /home/carla && ./CarlaUE4.sh -RenderOffScreen -nosound -carla-rpc-port=2000"]
